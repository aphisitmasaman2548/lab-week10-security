generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  message   String
  tag       String?
  authorId  String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  title     String
  url       String   @unique
  category  String
  createdAt DateTime @default(now())
}
